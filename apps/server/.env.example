# Copy to .env and fill in real values. The .env file holds the client secret
# and must never be committed. Only the partner id is ever exposed to the
# browser; the client id and secret stay here on the server.

# Which Spot API to target. Must be the SAME environment the widget quotes
# against, because a quote id is environment specific.
SPOT_API_BASE=https://api.sandbox.getspot.com

# Partner credentials, provisioned by Spot for your partner + environment.
SPOT_PARTNER_ID=your-partner-id
SPOT_CLIENT_ID=your-client-id
SPOT_CLIENT_SECRET=your-client-secret

# Per-partner secret Spot uses to sign outbound webhooks (X-Spot-Signature).
# This is NOT the OAuth client secret. Set the partner's real hmacSecret to
# verify real webhooks; the default only makes the local simulation round-trip.
SPOT_WEBHOOK_HMAC_SECRET=local-dev-hmac-secret

# Port this backend listens on, and the frontend origin(s) allowed to call it
# (comma separated). React runs on 5180, the vanilla variant on 5181.
PORT=8787
FRONTEND_ORIGIN=http://localhost:5180,http://localhost:5181
