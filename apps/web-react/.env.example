# Copy to .env.local and adjust as needed. Set your partner id below; the
# remaining values are optional.

# Target environment. The widget maps this to a base URL:
#   local      -> http://localhost:3999/api/v1/quote
#   sandbox    -> https://api.sandbox.getspot.com/api/v1/quote
#   production -> https://api.getspot.com/api/v1/quote
VITE_SPOT_ENV=local

# Partner id sent as the X-Spot-Partner-Id header. Spot provisions this for
# your partner account, per environment.
VITE_SPOT_PARTNER_ID=your-sandbox-partner-id

# Optional: overrides the environment base URL entirely when set.
# VITE_SPOT_CUSTOM_ENDPOINT=http://localhost:3999/api/v1/quote
